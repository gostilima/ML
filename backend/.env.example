# --- App ---
ENV=development
PROJECT_NAME="Marketplace Intelligence"
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# URL of the frontend app; used to redirect the browser back after the
# Mercado Livre OAuth callback (see /integrations/mercado-livre/oauth/callback)
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg2://mi_user:mi_password@localhost:5432/marketplace_intelligence
TEST_DATABASE_URL=sqlite:///./test.db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth / Security ---
JWT_SECRET=change-me-super-secret-value-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Fernet key for encrypting stored API credentials/tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- Mercado Livre OAuth (app-level defaults; org can supply its own client_id/secret) ---
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:8000/api/v1/integrations/mercado-livre/oauth/callback
MELI_AUTH_BASE_URL=https://auth.mercadolibre.com.br
MELI_API_BASE_URL=https://api.mercadolibre.com

# --- AI provider (optional; mock used when unset) ---
AI_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
